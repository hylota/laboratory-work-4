{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AR Tic-Tac-Toe Match Statistics"
  "description": "Ієрархічна схема даних ігрової партії та статистики гравців AR Tic-Tac-Toe",
  "type": "object",
  "properties": {
    "match": {
      "type": "object",
      "description": "Дані про ігрову партію",
      "properties": {
        "matchId": {
          "description": "Унікальний номер партії",
          "type": "integer",
          "minimum": 1
        },
        "matchDate": {
          "description": "Дата проведення партії",
          "type": "string",
          "format": "date"
        },
        "durationSec": {
          "description": "Тривалість партії у секундах",
          "type": "number",
          "minimum": 5,
          "maximum": 3600
        },
        "status": {
          "description": "Поточний статус ігрової партії",
          "type": "string",
          "pattern": "^(active|finished|aborted)$"
        },
        "board": {
          "type": "object",
          "description": "Дані калібрування ігрового поля",
          "properties": {
            "boardId": {
              "description": "Унікальний ідентифікатор ігрового поля",
              "type": "integer",
              "minimum": 1
            },
            "gridSize": {
              "description": "Розмірність сітки ігрового поля",
              "type": "integer",
              "minimum": 3,
              "maximum": 3
            },
            "cornerMarkers": {
              "description": "Список ID кутових маркерів поля",
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "required": ["boardId", "gridSize", "cornerMarkers"]
        },
        "players": {
          "type": "array",
          "description": "Список гравців у партії",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "userId": {
                "description": "Ідентифікатор користувача",
                "type": "integer",
                "minimum": 1
              },
              "userName": {
                "description": "Ім'я гравця",
                "type": "string",
                "minLength": 2,
                "maxLength": 20
              },
              "email": {
                "description": "Електронна пошта гравця",
                "type": "string",
                "format": "email"
              },
              "mobile": {
                "description": "Телефон гравця",
                "type": "string",
                "pattern": "^(\\([0-9]{3}\\))?[0-9]{3}-[0-9]{4}$"
              },
              "symbol": {
                "description": "Фішка гравця (X або O)",
                "type": "string",
                "pattern": "^[XO]$"
              },
              "rating": {
                "description": "Рейтинг гравця",
                "type": "number",
                "minimum": 0,
                "maximum": 5000
              },
              "gamesWon": {
                "description": "Список ID виграних партій",
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "integer"
                }
              }
            },
            "required": ["userId", "userName", "email", "mobile", "symbol", "rating"]
          }
        },
        "moves": {
          "type": "array",
          "description": "Історія здійснених та розпізнаних ходів",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "moveNumber": {
                "description": "Порядковий номер ходу",
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "cellCoord": {
                "description": "Координата клітинки (A1..C3)",
                "type": "string",
                "pattern": "^[A-C][1-3]$"
              },
              "responseTimeSec": {
                "description": "Час розпізнавання ходу камерою (с)",
                "type": "number",
                "minimum": 0.01,
                "maximum": 0.4
              },
              "isValid": {
                "description": "Ознака валідності ходу за правилами гри",
                "type": "boolean"
              },
              "marker": {
                "type": "object",
                "description": "Дані розпізнаного AR-маркера фішки",
                "properties": {
                  "markerCode": {
                    "description": "Код маркера ArUco",
                    "type": "string",
                    "pattern": "^ARUCO-[0-9]{3}$"
                  },
                  "markerType": {
                    "description": "Тип маркера (corner або piece)",
                    "type": "string",
                    "pattern": "^(corner|piece)$"
                  }
                },
                "required": ["markerCode", "markerType"]
              }
            },
            "required": ["moveNumber", "cellCoord", "responseTimeSec", "isValid", "marker"]
          }
        }
      },
      "required": ["matchId", "matchDate", "durationSec", "status", "board", "players", "moves"]
    }
  },
  "required": ["match"]
}
